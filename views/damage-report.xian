{{> head}}
<body class="bg-stone-50"><header class="bg-green-800 p-4 text-white"><a href="/dashboard" class="font-bold">← AgriSystem</a></header><main class="mx-auto max-w-2xl p-5"><h1 class="text-2xl font-bold">Submit Damage Report</h1><p class="mt-1 text-sm text-slate-500">Only approved farmers can submit reports.</p><form action="/farmer/report-damage" method="POST" class="mt-5 space-y-4 rounded-xl bg-white p-5 shadow"><select name="landId" required class="w-full rounded border p-2"><option value="">Select registered land</option>{{#each lands}}<option value="{{id}}">{{name}} — {{barangay}}</option>{{/each}}</select><input name="confirmedPlant" placeholder="Crop damaged (e.g. Rice)" required class="w-full rounded border p-2"><input name="confirmedDamageType" placeholder="Damage type (flood, pest, drought)" required class="w-full rounded border p-2"><input name="photoUrls" placeholder="Photo URL (upload service to follow)" class="w-full rounded border p-2"><textarea name="farmerNotes" placeholder="What happened to the farm?" class="w-full rounded border p-2" rows="4"></textarea><button class="rounded bg-green-700 px-4 py-2 text-white">Submit report</button></form></main>{{> footer}}
