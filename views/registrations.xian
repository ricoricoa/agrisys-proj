{{> head}}
<body class="bg-stone-50"><header class="bg-green-800 p-4 text-white"><a href="/dashboard" class="font-bold">← AgriSystem Admin</a></header><main class="mx-auto max-w-4xl p-5"><h1 class="text-2xl font-bold">Farmer Registrations</h1><div class="mt-5 space-y-3">{{#each farmers}}<article class="rounded-xl bg-white p-5 shadow"><b>Farmer profile #{{id}}</b><p class="mt-1 text-sm text-slate-500">{{address}} · {{barangay}}</p><form action="/admin/registrations/{{id}}" method="POST" class="mt-4 flex flex-wrap gap-2"><input name="reviewNotes" placeholder="Review notes" class="rounded border p-2 text-sm"><button name="status" value="approved" class="rounded bg-green-700 px-3 py-2 text-sm text-white">Approve</button><button name="status" value="rejected" class="rounded border border-red-300 px-3 py-2 text-sm text-red-700">Reject</button></form></article>{{else}}<p class="rounded-xl bg-white p-5 text-slate-500 shadow">No pending farmer registrations.</p>{{/each}}</div></main>{{> footer}}
