{{> head}}
<body class="bg-stone-50"><header class="bg-green-800 p-4 text-white"><a href="/dashboard" class="font-bold">← AgriSystem</a></header><main class="mx-auto max-w-4xl p-5"><div class="flex justify-between"><h1 class="text-2xl font-bold">My Damage Reports</h1><a href="/farmer/report-damage" class="rounded bg-green-700 px-3 py-2 text-sm text-white">New report</a></div><div class="mt-5 space-y-3">{{#each reports}}<article class="rounded-xl bg-white p-4 shadow"><div class="flex justify-between"><b>{{confirmedPlant}}</b><span class="capitalize text-sm">{{status}}</span></div><p class="mt-1 text-sm text-slate-600">{{confirmedDamageType}}</p><p class="mt-1 text-xs text-slate-400">{{createdAt}}</p></article>{{else}}<p class="rounded-xl bg-white p-5 text-slate-500 shadow">No reports yet.</p>{{/each}}</div></main>{{> footer}}
