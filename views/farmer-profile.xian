{{> head}}
<body class="bg-stone-50"><header class="bg-green-800 p-4 text-white"><a href="/dashboard" class="font-bold">← AgriSystem</a></header><main class="mx-auto max-w-4xl p-5"><h1 class="text-2xl font-bold">My Profile & Land</h1><div class="mt-5 grid gap-5 md:grid-cols-2"><section class="rounded-xl bg-white p-5 shadow"><h2 class="font-bold">Farmer registration</h2>{{#if profile}}<p class="mt-3 text-sm">Status: <b class="capitalize">{{profile.registrationStatus}}</b></p><p class="mt-2 text-sm text-slate-600">{{profile.address}}<br>{{profile.barangay}}</p>{{else}}<form action="/farmer/profile" method="POST" class="mt-4 space-y-3"><input name="address" placeholder="Home address" required class="w-full rounded border p-2"><input name="barangay" placeholder="Barangay" class="w-full rounded border p-2"><button class="rounded bg-green-700 px-4 py-2 text-white">Save farmer profile</button></form>{{/if}}<h2 class="mt-6 font-bold">My registered land</h2>{{#each lands}}<div class="mt-2 rounded border p-3 text-sm"><b>{{name}}</b><br>{{sizeHectares}} hectares · {{cropTypes}}</div>{{else}}<p class="mt-2 text-sm text-slate-500">No land saved yet.</p>{{/each}}</section><section class="rounded-xl bg-white p-5 shadow"><h2 class="font-bold">Add land</h2><form action="/farmer/lands" method="POST" class="mt-4 space-y-3"><input name="name" placeholder="Land name" class="w-full rounded border p-2"><input name="barangay" placeholder="Barangay" required class="w-full rounded border p-2"><input name="address" placeholder="Land address" class="w-full rounded border p-2"><input name="sizeHectares" type="number" step="0.01" placeholder="Size in hectares" required class="w-full rounded border p-2"><input name="cropTypes" placeholder="Crops: rice, corn..." required class="w-full rounded border p-2"><div class="grid grid-cols-2 gap-2"><input name="latitude" type="number" step="any" placeholder="Latitude" required class="w-full rounded border p-2"><input name="longitude" type="number" step="any" placeholder="Longitude" required class="w-full rounded border p-2"></div><button class="rounded bg-green-700 px-4 py-2 text-white">Save land</button></form></section></div></main>{{> footer}}
