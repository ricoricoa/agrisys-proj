{{> head}}
<body class="bg-stone-50"><header class="bg-green-800 p-4 text-white"><a href="/dashboard" class="font-bold">← AgriSystem</a></header><main class="mx-auto max-w-3xl p-5"><h1 class="text-2xl font-bold">My Notifications</h1><div class="mt-5 space-y-3">{{#each notifications}}<article class="rounded-xl bg-white p-4 shadow"><p class="text-xs font-bold uppercase text-green-700">{{type}}</p><p class="mt-1">{{message}}</p></article>{{else}}<p class="rounded-xl bg-white p-5 text-slate-500 shadow">No notifications yet.</p>{{/each}}</div></main>{{> footer}}
