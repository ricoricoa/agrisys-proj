{{> head}}
<body class="bg-stone-50"><header class="bg-green-800 p-4 text-white"><a href="/dashboard" class="font-bold">← AgriSystem Admin</a></header><main class="mx-auto max-w-5xl p-5"><h1 class="text-2xl font-bold">User Management</h1><div class="mt-5 overflow-x-auto rounded-xl bg-white p-4 shadow"><table class="w-full text-left text-sm"><thead><tr class="border-b"><th class="p-2">Name</th><th class="p-2">Email</th><th class="p-2">Contact</th><th class="p-2">Role</th></tr></thead><tbody>{{#each users}}<tr class="border-b"><td class="p-2">{{name}}</td><td class="p-2">{{email}}</td><td class="p-2">{{contactNumber}}</td><td class="p-2 capitalize">{{role}}</td></tr>{{/each}}</tbody></table></div></main>{{> footer}}
