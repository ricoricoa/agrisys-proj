{{> head}}<body class="bg-slate-50 text-slate-800">{{> navigation}}<main class="mx-auto max-w-3xl px-5 py-8"><p class="text-xs font-bold uppercase tracking-[.16em] text-emerald-700">MAO operations</p><h1 class="mt-2 text-3xl font-extrabold">Send farmer notification</h1><p class="mt-2 text-slate-500">Share benefit availability, weather alerts, and schedule reminders.</p>{{#if success_msg}}<p class="mt-5 rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800">{{success_msg}}</p>{{/if}}{{#if error_msg}}<p class="mt-5 rounded-xl bg-red-50 p-3 text-sm text-red-700">{{error_msg}}</p>{{/if}}<form action="/staff/notifications" method="POST" class="card mt-6 space-y-4"><label class="block text-sm font-bold">Recipient<select class="field mt-1" name="farmerId" required><option value="">Select approved farmer</option>{{#each farmers}}<option value="{{id}}">Farmer profile #{{id}} — {{barangay}}</option>{{/each}}</select></label><label class="block text-sm font-bold">Type<select class="field mt-1" name="type"><option value="alert">Alert</option><option value="benefit">Benefit / assistance</option></select></label><label class="block text-sm font-bold">Message<textarea class="field mt-1" name="message" rows="5" placeholder="Write the message for the farmer" required></textarea></label><button class="btn">Send notification</button></form></main>{{> footer}}
