{{> head}}<body class="bg-slate-50 text-slate-800">{{> navigation}}<main class="mx-auto max-w-6xl px-5 py-8"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-[.16em] text-emerald-700">Municipal Agriculture Office</p><h1 class="mt-2 text-3xl font-extrabold text-slate-900">Good day, {{userName}}</h1><p class="mt-2 text-slate-500">Monitor farm-damage reports and support activity from one dashboard.</p></div><a href="/farmer/report-damage" class="btn">Report farm damage</a></div>{{#if success_msg}}<p class="mt-5 rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800">{{success_msg}}</p>{{/if}}<section class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><div class="card"><p class="text-sm text-slate-500">All reports</p><b class="mt-1 block text-3xl">{{totalReports}}</b></div><div class="card bg-amber-50"><p class="text-sm text-amber-800">Pending review</p><b class="mt-1 block text-3xl">{{pendingReports}}</b></div><div class="card bg-sky-50"><p class="text-sm text-sky-800">Verified</p><b class="mt-1 block text-3xl">{{verifiedReports}}</b></div><div class="card bg-emerald-50"><p class="text-sm text-emerald-800">Pending farmers</p><b class="mt-1 block text-3xl">{{pendingFarmers}}</b></div></section><section class="mt-7 card"><div class="flex items-center justify-between"><div><h2 class="font-bold">Latest damage reports</h2><p class="mt-1 text-sm text-slate-500">Recent submissions needing monitoring.</p></div>{{#if canReview}}<a href="/staff/reports" class="font-bold text-sm text-emerald-700">Open review queue</a>{{/if}}</div><div class="mt-4 overflow-x-auto"><table class="w-full text-left text-sm"><thead class="border-b text-slate-500"><tr><th class="p-3">Crop</th><th class="p-3">Damage</th><th class="p-3">Status</th><th class="p-3">Submitted</th></tr></thead><tbody>{{#each reports}}<tr class="border-b last:border-0"><td class="p-3 font-semibold">{{confirmedPlant}}</td><td class="p-3">{{confirmedDamageType}}</td><td class="p-3 capitalize"><span class="rounded-full bg-amber-100 px-2 py-1 text-xs font-bold text-amber-800">{{status}}</span></td><td class="p-3 text-slate-500">{{createdAt}}</td></tr>{{else}}<tr><td colspan="4" class="p-5 text-center text-slate-500">No reports submitted yet.</td></tr>{{/each}}</tbody></table></div></section></main>{{> footer}}
