<header class="border-b border-emerald-950/15 bg-gradient-to-r from-emerald-950 via-emerald-800 to-teal-700 text-white shadow-sm">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-4">
    <a href="/dashboard" class="text-lg font-extrabold tracking-tight">AgriSystem <span class="font-medium text-emerald-200">MAO</span></a>
    {{#if currentUser}}<div class="flex items-center gap-3 text-sm"><span class="hidden text-emerald-100 sm:inline">Hi, {{currentUser}}</span><a href="/logout" class="rounded-lg border border-white/25 px-3 py-1.5 font-semibold transition hover:bg-white/10">Sign out</a></div>{{else}}<div class="flex gap-2 text-sm"><a href="/login" class="rounded-lg px-3 py-1.5 hover:bg-white/10">Sign in</a><a href="/register" class="rounded-lg bg-white px-3 py-1.5 font-semibold text-emerald-800">Register</a></div>{{/if}}
  </div>
</header>
{{#if currentUser}}<nav class="border-b bg-white"><div class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-4 py-2 text-sm font-medium text-slate-600"><a class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-emerald-50 hover:text-emerald-800" href="/dashboard">Dashboard</a><a class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-emerald-50 hover:text-emerald-800" href="/farmer/profile">My Farm</a><a class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-emerald-50 hover:text-emerald-800" href="/farmer/report-damage">Report Damage</a><a class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-emerald-50 hover:text-emerald-800" href="/farmer/reports">My Reports</a><a class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-emerald-50 hover:text-emerald-800" href="/farmer/notifications">Notifications</a>{{#if canReview}}<a class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-emerald-50 hover:text-emerald-800" href="/staff/reports">Review Queue</a><a class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-emerald-50 hover:text-emerald-800" href="/staff/notifications">Send Alert</a>{{/if}}{{#if isAdmin}}<a class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-emerald-50 hover:text-emerald-800" href="/admin/registrations">Registrations</a><a class="whitespace-nowrap rounded-lg px-3 py-2 hover:bg-emerald-50 hover:text-emerald-800" href="/admin/users">Users</a>{{/if}}</div></nav>{{/if}}
