<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>{{ title }} | AgriSystem</title>
  <style>body{font-family:Inter,ui-sans-serif,system-ui,sans-serif}.field{width:100%;border:1px solid #cbd5e1;border-radius:.65rem;padding:.65rem .75rem;outline:none}.field:focus{border-color:#059669;box-shadow:0 0 0 3px #d1fae5}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:.65rem;background:#047857;padding:.6rem 1rem;font-weight:700;color:#fff;transition:.15s}.btn:hover{background:#065f46}.card{border:1px solid #e2e8f0;border-radius:1rem;background:#fff;padding:1.25rem;box-shadow:0 1px 3px #0f172a0d}</style>
</head>
