{{> head}}
<body class="bg-stone-50"><header class="bg-green-800 p-4 text-white"><a href="/dashboard" class="font-bold">← AgriSystem Staff</a></header><main class="mx-auto max-w-4xl p-5"><h1 class="text-2xl font-bold">Review Damage Reports</h1><div class="mt-5 space-y-3">{{#each reports}}<article class="rounded-xl bg-white p-5 shadow"><div class="flex justify-between"><div><b>{{confirmedPlant}}</b><p class="text-sm text-slate-500">{{confirmedDamageType}}</p></div><span class="capitalize">{{status}}</span></div><form action="/staff/reports/{{id}}/review" method="POST" class="mt-4 flex flex-wrap gap-2"><input name="confirmedPlant" placeholder="Confirm crop" class="rounded border p-2 text-sm"><input name="confirmedDamageType" placeholder="Confirm damage" class="rounded border p-2 text-sm"><button name="status" value="verified" class="rounded bg-green-700 px-3 py-2 text-sm text-white">Verify</button><button name="status" value="rejected" class="rounded border border-red-300 px-3 py-2 text-sm text-red-700">Reject</button></form></article>{{else}}<p class="rounded-xl bg-white p-5 text-slate-500 shadow">No reports to review.</p>{{/each}}</div></main>{{> footer}}
